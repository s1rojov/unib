# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring.

# Django
DJANGO_SECRET_KEY=almashtiring-uzun-tasodifiy-qator
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
# HTTPS proxy ortida ishlaganda 1 (majburiy HTTPS, secure cookie)
DJANGO_SECURE=1

# PostgreSQL
DB_NAME=davomat
DB_USER=davomat
DB_PASSWORD=almashtiring-db-paroli

# Andozalar va RTSP rekvizitlarini shifrlash kaliti (Fernet, 32 bayt base64).
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kalitni almashtirish: yangi kalitni birinchi yozing, eskisini vergul bilan qoldiring.
FIELD_ENCRYPTION_KEYS=

# Birinchi administrator (faqat birinchi ishga tushirishda yaratiladi)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# HTTPS manzil (LAN IP yoki domen)
SITE_ADDRESS=localhost
HTTPS_PORT=443
HTTP_PORT=80

# Worker
WORKER_THREADS=2
