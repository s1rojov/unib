# Lokal ishga tushirish (Docker'siz, SQLite). Nusxa: copy .env.example .env  — so'ng kalitlarni to'ldiring.
DJANGO_DEBUG=1
DJANGO_SECURE=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Shifrlash kaliti (yo'qotmang): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin12345!
WORKER_THREADS=1
